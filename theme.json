{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "base-2", "color": "#f4f5f8", "name": "Base 2" },
				{ "slug": "base-3", "color": "#e8e8e8", "name": "Base 3" },
				{ "slug": "contrast", "color": "#222222", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#555a66", "name": "Contrast 2" },
				{ "slug": "muted", "color": "#888888", "name": "Muted" },
				{ "slug": "primary", "color": "#0076ff", "name": "Primary" },
				{ "slug": "primary-2", "color": "#218ddf", "name": "Primary 2" },
				{ "slug": "accent", "color": "#914cc8", "name": "Accent" },
				{ "slug": "navy", "color": "#192d5b", "name": "Navy" },
				{ "slug": "charcoal", "color": "#3e424e", "name": "Charcoal" },
				{ "slug": "ink", "color": "#07254f", "name": "Ink" }
			],
			"gradients": [
				{ "slug": "primary-accent", "name": "Primary to accent", "gradient": "linear-gradient(120deg, #0076ff 0%, #914cc8 100%)" },
				{ "slug": "accent-primary", "name": "Accent to primary", "gradient": "linear-gradient(120deg, #914cc8 0%, #0076ff 100%)" },
				{ "slug": "navy-ink", "name": "Navy to ink", "gradient": "linear-gradient(180deg, #192d5b 0%, #07254f 100%)" },
				{ "slug": "shade-bottom", "name": "Shade (bottom)", "gradient": "linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%)" }
			],
			"duotone": [
				{ "slug": "primary-grayscale", "name": "Primary and black", "colors": [ "#0a0a0a", "#0076ff" ] },
				{ "slug": "grayscale", "name": "Grayscale", "colors": [ "#111111", "#f4f5f8" ] }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 10px 30px rgba(17, 24, 39, 0.08)" },
				{ "slug": "lift", "name": "Lift", "shadow": "0 18px 40px rgba(17, 24, 39, 0.16)" },
				{ "slug": "deep", "name": "Deep", "shadow": "0 -5px 15px rgba(0, 0, 0, 0.3)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "40", "name": "4", "size": "clamp(1.75rem, 3vw, 2.25rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(2.5rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3.5rem, 7vw, 5.625rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(5rem, 10vw, 8rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Roboto Slab",
					"fontFamily": "\"Roboto Slab\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Roboto Slab",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/roboto-slab-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Raleway",
					"fontFamily": "Raleway, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Raleway",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/raleway-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Raleway",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/raleway-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		},
		"custom": {
			"transition": "0.25s ease",
			"radius": { "pill": "5em", "small": "4px", "medium": "8px" },
			"header": { "height": "84px" }
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast-2)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				},
				":focus": {
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "1.125rem" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.18em",
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "5em",
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": { "top": "0.7em", "bottom": "0.7em", "left": "1.8em", "right": "1.8em" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.03em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--navy)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.04em"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.75rem",
					"fontWeight": "700"
				},
				"elements": {
					"link": { "color": { "text": "inherit" } }
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "inherit" },
						":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
					}
				}
			},
			"core/post-date": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em",
					"fontWeight": "700"
				}
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--primary)", "width": "3px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "1.5rem" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" },
				"border": {
					"top": { "color": "var(--wp--preset--color--primary)", "width": "3px", "style": "solid" },
					"bottom": { "color": "var(--wp--preset--color--primary)", "width": "3px", "style": "solid" }
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--base-3)" }
			},
			"core/search": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--base-2)" },
				"border": { "radius": "4px" }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing (transparent header)", "postTypes": [ "page" ] },
		{ "name": "page-full-width", "title": "Full width, no title", "postTypes": [ "page", "post" ] },
		{ "name": "page-sidebar", "title": "Page with sidebar", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "header-overlay", "title": "Header (transparent overlay)", "area": "header" },
		{ "name": "header-business", "title": "Header (business, with top bar)", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "footer-simple", "title": "Footer (simple)", "area": "footer" },
		{ "name": "sidebar", "title": "Blog sidebar", "area": "uncategorized" },
		{ "name": "page-header", "title": "Page title bar", "area": "uncategorized" }
	]
}
